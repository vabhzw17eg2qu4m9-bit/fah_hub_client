#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  QUALITY GATE — DO NOT LOWER THESE THRESHOLDS WITHOUT TEAM APPROVAL       ║
# ║  Every commit must pass: file size, analyze, format, tests,               ║
# ║  coverage ≥ 80%, CRAP ratchet (crap4dart.yaml), duplication < 1%.         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Pre-commit hook for fah_hub_client (pure Dart package).
# Canonical copy: scripts/pre-commit — install with:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# To skip (emergency only): git commit --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Unset git env vars so test processes that spawn git subprocesses use the
# correct working directory rather than the hook's environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE 2>/dev/null || true

COVERAGE_BASELINE=80.0
DUP_THRESHOLD=1.0
MAX_LINES=2800

# ═══════════════════════════════════════════════════════════════════════════
# 1. FILE SIZE GUARD
# ═══════════════════════════════════════════════════════════════════════════
VIOLATIONS=()
while IFS= read -r file; do
  case "$file" in
    *.g.dart|*.freezed.dart|*.mocks.dart) continue ;;
  esac
  lines=$(wc -l < "$file")
  if (( lines > MAX_LINES )); then
    VIOLATIONS+=("  $file: $lines lines (max $MAX_LINES)")
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.dart')

if ((${#VIOLATIONS[@]} > 0)); then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — FILE SIZE                                       ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  printf '%s\n' "${VIOLATIONS[@]}"
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 2. STATIC ANALYSIS
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Running dart analyze..."
dart analyze

# ═══════════════════════════════════════════════════════════════════════════
# 3. FORMAT — self-healing on the staged set, with a blocking backstop
# ═══════════════════════════════════════════════════════════════════════════
# Reformat exactly the Dart files in the index and re-stage them; anything
# still unformatted after that (formatter crashed on syntax errors) blocks
# the commit. Scoped to the staged set so concurrent agents' WIP files are
# never rewritten and whole-tree drift never fails unrelated commits.
mapfile -t STAGED_DART < <(git diff --cached --name-only --diff-filter=ACM -- '*.dart')
if ((${#STAGED_DART[@]} > 0)); then
  echo "🎨 Auto-formatting staged Dart files..."
  printf '%s\n' "${STAGED_DART[@]}" | xargs dart format >/dev/null 2>&1 || true
  git add -- "${STAGED_DART[@]}"
  UNFORMATTED=$(dart format --output=none --set-exit-if-changed \
    "${STAGED_DART[@]}" 2>/dev/null | grep '^Changed' || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ dart format could not fix these files (syntax error?):"
    echo "$UNFORMATTED"
    exit 1
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# 4. TESTS WITH COVERAGE
# ═══════════════════════════════════════════════════════════════════════════
echo "🧪 Running dart test --coverage..."
rm -rf coverage
dart test --coverage=coverage

echo "📊 Formatting coverage to lcov..."
if ! dart run coverage:format_coverage --lcov --in=coverage \
    --out=coverage/lcov.info --report-on=lib; then
  # Not resolvable from pubspec (coverage is not a direct dev_dep yet) —
  # fall back to a globally activated copy.
  dart pub global activate coverage
  dart pub global run coverage:format_coverage --lcov --in=coverage \
    --out=coverage/lcov.info --report-on=lib
fi

# ═══════════════════════════════════════════════════════════════════════════
# 5. COVERAGE RATCHET (lib/ only)
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Checking line coverage (baseline: >= ${COVERAGE_BASELINE}%)..."
if python3 - "$COVERAGE_BASELINE" <<'PYEOF'
import os
import sys

baseline = float(sys.argv[1])
if not os.path.isfile("coverage/lcov.info"):
    print("ERROR: coverage/lcov.info not found. Run: dart test --coverage=coverage")
    sys.exit(1)

total_found = 0
total_hit = 0
for sec in open("coverage/lcov.info").read().split("SF:")[1:]:
    lines = sec.strip().split("\n")
    path = lines[0]
    relpath = os.path.relpath(path)
    if not (relpath.startswith("lib/") or "/lib/" in path):
        continue
    for line in lines[1:]:
        if line.startswith("DA:"):
            total_found += 1
            if int(line[3:].split(",")[1]) > 0:
                total_hit += 1

if total_found == 0:
    print("ERROR: no lib/ coverage data found in lcov.info")
    sys.exit(1)

pct = 100.0 * total_hit / total_found
print(f"Coverage (lib/): {pct:.2f}% ({total_hit}/{total_found} lines), baseline {baseline}%")
sys.exit(0 if pct >= baseline else 1)
PYEOF
then
  echo "✅ Coverage gate OK"
else
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — TEST COVERAGE                                   ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  echo "   Add tests for uncovered code, then retry."
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 6. CRAP RATCHET (complexity × coverage; threshold pinned in crap4dart.yaml)
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Checking CRAP scores (ratchet: only down from the pinned max)..."
if ! dart pub global run crap4dart:crap4dart --version >/dev/null 2>&1; then
  dart pub global activate crap4dart 0.2.1
fi
# Reuses the fresh coverage/lcov.info produced above.
if dart pub global run crap4dart:crap4dart analyze; then
  echo "✅ CRAP gate OK"
else
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — CRAP RATCHET                                    ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  echo "   A method's CRAP score exceeded the pinned max in crap4dart.yaml."
  echo "   Simplify it or add tests — the threshold only goes DOWN."
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 7. CODE DUPLICATION GUARD
# ═══════════════════════════════════════════════════════════════════════════
if command -v npx >/dev/null 2>&1; then
  echo "🔍 Checking code duplication (threshold < ${DUP_THRESHOLD}%)..."
  # jscpd exits non-zero when duplication exceeds --threshold.
  npx -y jscpd --min-tokens 50 --min-lines 5 \
    --threshold "$DUP_THRESHOLD" --reporters consoleFull lib/
  echo "✅ Duplication gate OK (< ${DUP_THRESHOLD}%)"
else
  echo "⚠️  npx not found, skipping duplication check (npm install -g jscpd)"
fi

echo ""
echo "╔═══════════════════════════════════════════════════════════════════════════╗"
echo "║  ✅ ALL QUALITY GATES PASSED — COMMIT APPROVED                            ║"
echo "╚═══════════════════════════════════════════════════════════════════════════╝"
